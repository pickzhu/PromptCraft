<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i18n="clr-namespace:Ke.Bee.Localization.Extensions;assembly=Ke.Bee.Localization"
             xmlns:vm="using:PromptCraft.ViewModels.PromptLibrary"
             d:DesignWidth="380" d:DesignHeight="600"
             x:DataType="vm:PromptLibraryTagDrawerModel"
             x:Class="PromptCraft.Controls.PromptLibraryTagDrawer"
             mc:Ignorable="d">

    <!-- 词库标签管理抽屉：UI 对齐图库 TagManagerDrawer（遮罩 + 右侧面板），数据走词库 PromptTag -->
    <Grid>
        <Border Name="DrawerOverlay" IsVisible="{Binding IsOpen}"
                Background="{DynamicResource OverlayMediumBrush}" PointerPressed="OnOverlayClick"
                IsHitTestVisible="True" />

        <Border Name="TagDrawer" Width="380" HorizontalAlignment="Right"
                Background="{DynamicResource SukiCardBackground}" IsVisible="{Binding IsOpen}"
                Padding="16" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1,0,0,0"
                BoxShadow="-4 0 10 #66000000">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="{i18n:Localize TagManager}" FontSize="16" FontWeight="DemiBold" />
                        <TextBlock Text="{i18n:Localize PromptTagManagerDescription}" FontSize="11" Foreground="Gray"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0"
                            FontSize="14" VerticalAlignment="Top" Command="{Binding CloseCommand}"
                            BorderThickness="0" Background="Transparent" />
                </Grid>

                <TextBlock Grid.Row="1" Text="{i18n:Localize NewTagSection}" FontSize="13" FontWeight="DemiBold"
                           Margin="0,6,0,0" />
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding NewTagName, Mode=TwoWay}"
                                 PlaceholderText="{i18n:Localize NewTagPlaceholder}"
                                 Classes="Borderless" MaxLength="40" />
                        <TextBlock Grid.Column="1" Text="{Binding NewTagCounter}" FontSize="11"
                                   Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <Button Grid.Column="1" Content="{i18n:Localize AddTag}" Height="32" Padding="14,0"
                            FontSize="13" FontWeight="DemiBold" Command="{Binding AddTagCommand}"
                            Background="{DynamicResource TagBlueBrush}" Foreground="White" BorderBrush="{DynamicResource TagBlueBrush}"
                            CornerRadius="4" />
                </Grid>

                <TextBlock Grid.Row="3" Text="{i18n:Localize ExistingTagsSection}" FontSize="13" FontWeight="DemiBold"
                           Margin="0,6,0,0" />
                <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="Gray"
                               TextWrapping="Wrap" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ScrollViewer Grid.Row="1" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PromptTagEditItem">
                                    <Border Background="{DynamicResource SukiControlBackground}"
                                            CornerRadius="4" Padding="10,8" BorderBrush="{DynamicResource SukiBorderBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Border Width="10" Height="10" CornerRadius="2"
                                                    Background="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Content="✎" Width="26" Height="26" Padding="0"
                                                    FontSize="12" ToolTip.Tip="{i18n:Localize EditTag}"
                                                    Command="{Binding $parent[ItemsControl].((vm:PromptLibraryTagDrawerModel)DataContext).EditTagCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="3" Content="🗑" Width="26" Height="26" Padding="0"
                                                    FontSize="12" Margin="6,0,0,0" ToolTip.Tip="{i18n:Localize PromptDelete}"
                                                    Command="{Binding $parent[ItemsControl].((vm:PromptLibraryTagDrawerModel)DataContext).DeleteTagCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
