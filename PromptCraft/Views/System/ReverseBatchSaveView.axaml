<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PromptCraft.ViewModels.System"
             xmlns:libraryVm="using:PromptCraft.ViewModels.PromptLibrary"
             xmlns:i18n="clr-namespace:Ke.Bee.Localization.Extensions;assembly=Ke.Bee.Localization"
             d:DesignWidth="560" d:DesignHeight="520"
             x:DataType="vm:ReverseBatchSaveModel"
             x:Class="PromptCraft.ReverseBatchSaveView"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto" Margin="8" Width="540">
        <!-- 说明 -->
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Foreground="Gray" FontSize="12"/>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,10">
            <StackPanel Spacing="10">
                <!-- 封面 -->
                <Border Height="150" CornerRadius="8" ClipToBounds="True"
                        Background="{DynamicResource OverlayLightBrush}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1"
                        Cursor="Hand" PointerPressed="OnCoverClick">
                    <Grid>
                        <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"
                               IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="🖼" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="{i18n:Localize ReverseCoverPickerHint}" FontSize="12"
                                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 文件夹（多对多多选，空=未分类） -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{i18n:Localize ReverseTargetFolderLabel}" FontSize="12" Foreground="Gray"/>
                    <DropDownButton MinWidth="200" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding SelectedFoldersSummary}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Border Background="{DynamicResource SukiCardBackground}"
                                        BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1"
                                        MinWidth="220" MaxHeight="240" CornerRadius="6">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding Folders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="libraryVm:PromptFolderItem">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Command="{Binding $parent[ItemsControl].((vm:ReverseBatchSaveModel)DataContext).ToggleFolderCommand}"
                                                              CommandParameter="{Binding}"
                                                              Margin="0,0,10,6" Padding="6,4">
                                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <!-- 标签（多选 + 即时新建，对齐 PromptMaster allow-create） -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{i18n:Localize ReverseTagsLabel}" FontSize="12" Foreground="Gray"/>
                    <ScrollViewer MaxHeight="140">
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="libraryVm:PromptTagItem">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Command="{Binding $parent[ItemsControl].((vm:ReverseBatchSaveModel)DataContext).ToggleTagCommand}"
                                              CommandParameter="{Binding}"
                                              Tag="{Binding}" Margin="0,0,10,6">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Border Width="8" Height="8" CornerRadius="2"
                                                    Background="{Binding Color}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding NewTagName, Mode=TwoWay}"
                                 PlaceholderText="{i18n:Localize ReverseNewTagPlaceholder}"
                                 Classes="Borderless" MaxLength="40"/>
                        <Button Grid.Column="1" Content="{i18n:Localize PeCreateNewLabel}" FontSize="12" Padding="10,0"
                                Command="{Binding AddNewTagCommand}"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：仅状态（body 取消/保存已移除 → 宿主 foot 提供 [取消][保存]） -->
        <Grid Grid.Row="2" ColumnDefinitions="*">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="Gray"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</UserControl>
