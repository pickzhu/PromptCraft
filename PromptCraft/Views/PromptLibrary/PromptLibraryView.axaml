<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:PromptCraft.Controls"
             xmlns:vm="using:PromptCraft.ViewModels.PromptLibrary"
             xmlns:i18n="clr-namespace:Ke.Bee.Localization.Extensions;assembly=Ke.Bee.Localization"
             d:DesignWidth="1200" d:DesignHeight="800"
             x:DataType="vm:PromptLibraryModel"
             x:Class="PromptCraft.Views.PromptLibrary.PromptLibraryView"
             mc:Ignorable="d">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="16">
            <!-- 工具栏（对齐图库 ComfyGallery：搜索 + 标签筛选 + 清空选中 + 全选 + 新建 + 标签管理 + 批量删除 + 刷新；文件夹浏览统一走文件夹管理页） -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="{i18n:Localize PromptSearchPlaceholder}"
                         Classes="Borderless" VerticalContentAlignment="Center" Height="32" />
                <controls:PromptTagFilterDropDown Grid.Column="1"
                                                  x:Name="TagFilterDropDown"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding AvailableTags}"
                                                  SelectionChanged="OnTagSelectionChanged" />
                <!-- 清空选中（只清空选中项，跟随标签下拉；尺寸与其他工具栏按钮一致） -->
                <Button Grid.Column="2" Content="{i18n:Localize PromptClearSelection}" FontSize="13" Padding="12,0"
                        Command="{Binding ClearSelectionCommand}" IsVisible="{Binding HasSelection}"
                        VerticalAlignment="Center" Height="32" />
                <Button Grid.Column="3" Content="{i18n:Localize PromptSelectAllPage}" FontSize="13" Padding="12,0"
                        Command="{Binding ToggleSelectPageCommand}" VerticalAlignment="Center" Height="32" />
                <Button Grid.Column="4" Content="{i18n:Localize PromptNew}" FontSize="13" Padding="12,0"
                        FontWeight="DemiBold"
                        Command="{Binding NewPromptCommand}" VerticalAlignment="Center" Height="32" />
                <Button Grid.Column="5" Content="{i18n:Localize PromptTags}" FontSize="13" Padding="12,0"
                        Command="{Binding OpenTagDrawerCommand}" VerticalAlignment="Center" Height="32" />
                <Button Grid.Column="6" Content="{i18n:Localize PromptBatchDelete}" FontSize="13" Padding="12,0"
                        Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}"
                        VerticalAlignment="Center" Height="32" />
                <Button Grid.Column="7" Content="{i18n:Localize PromptRefresh}" FontSize="13" Padding="12,0"
                        Command="{Binding LoadCommand}" VerticalAlignment="Center" Height="32" />
            </Grid>

            <!-- 状态行：统计 -->
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="Gray"
                               VerticalAlignment="Center" />
                    <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center"
                               Text="{Binding TotalCountText}" />
                </StackPanel>
            </Grid>

            <!-- 瀑布流卡片（对齐图库 ComfyGallery：WrapPanel 等宽卡片 + 无限滚动加载） -->
            <ScrollViewer Grid.Row="2" x:Name="PromptScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Prompts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PromptCardItem">
                            <!-- 卡片：单击=选中 / Ctrl=多选 / 双击=编辑详情 / 右键=菜单；样式对齐图库 -->
                            <Border Width="170" CornerRadius="8" Padding="6" Margin="4"
                                    BorderThickness="2" PointerPressed="OnCardPointerPressed"
                                    Classes.Selected="{Binding IsSelected}">
                                <Border.Styles>
                                    <Style Selector="Border">
                                        <Setter Property="Background" Value="{DynamicResource SukiDarkColor}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SukiBorderBrush}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SukiPrimaryColor}" />
                                    </Style>
                                    <Style Selector="Border.Selected">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
                                    </Style>
                                </Border.Styles>
                                <Grid>
                                    <Border CornerRadius="4" Background="{DynamicResource PrimaryBrush}" Width="20" Height="20"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,4,4,0" IsVisible="{Binding IsSelected}">
                                        <TextBlock Text="✓" Foreground="White" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <!-- 封面：单击/双击冒泡到卡片（选中/编辑）；封面拖拽导出已移除 -->
                                        <Border CornerRadius="6" ClipToBounds="True" Height="120"
                                                Background="{DynamicResource SukiBorderBrush}">
                                            <Grid>
                                                <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill" Width="158"
                                                       IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                                                    <TextBlock Text="🖼" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{i18n:Localize PromptNoCover}" FontSize="10"
                                                               Foreground="Gray" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding Title}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="158"
                                                   FontSize="12" Margin="0,6,0,2" />
                                        <TextBlock Text="{Binding UpdatedAtDisplay}" FontSize="10" Foreground="Gray" />

                                        <!-- 标签行（点击标签 = 按该标签筛选；颜色用全局标签池持久化色） -->
                                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,2,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PromptTagChip">
                                                    <Border CornerRadius="3" Background="{Binding Color}" Padding="4,1"
                                                            Margin="1" MaxWidth="70" PointerPressed="OnTagChipClick" Tag="{Binding}">
                                                        <TextBlock Text="{Binding Name}" FontSize="9" Foreground="White"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 右键菜单（对齐图库 ImageContextPopup：按下瞬间打开，菜单项关菜单后执行；偏移清零防漂移） -->
        <Popup x:Name="PromptContextPopup" Placement="Pointer" IsLightDismissEnabled="True"
               HorizontalOffset="0" VerticalOffset="0">
            <Border CornerRadius="6" Background="{DynamicResource SukiCardBackground}"
                    BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1"
                    BoxShadow="0 4 14 #55000000">
                <StackPanel MinWidth="196">
                    <TextBlock x:Name="ContextTitle" FontSize="11" Foreground="{DynamicResource SukiLowText}"
                               Padding="16,8,16,4" />
                    <Rectangle Height="1" Fill="{DynamicResource SukiBorderBrush}" Margin="8,2" />

                    <Button x:Name="ContextEditButton" Content="{i18n:Localize PromptEdit}" Click="OnEditMenuItemClick"
                            HorizontalContentAlignment="Left" Padding="16,9" FontWeight="DemiBold"
                            Background="Transparent" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="ContextCopyPosButton" Content="{i18n:Localize PromptCopyPositive}" Click="OnCopyPositiveMenuItemClick"
                            HorizontalContentAlignment="Left" Padding="16,9" FontWeight="DemiBold"
                            Background="Transparent" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="ContextCopyNegButton" Content="{i18n:Localize PromptCopyNegative}" Click="OnCopyNegativeMenuItemClick"
                            HorizontalContentAlignment="Left" Padding="16,9" FontWeight="DemiBold"
                            Background="Transparent" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="ContextCopyCoverButton" Content="{i18n:Localize PromptCopyCover}" Click="OnCopyCoverMenuItemClick"
                            HorizontalContentAlignment="Left" Padding="16,9" FontWeight="DemiBold"
                            Background="Transparent" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="ContextBigImageButton" Content="{i18n:Localize PromptBigImage}" Click="OnBigImageMenuItemClick"
                            HorizontalContentAlignment="Left" Padding="16,9" FontWeight="DemiBold"
                            Background="Transparent" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
                            </Style>
                        </Button.Styles>
                    </Button>

                    <!-- 打标签（多选时对全部选中提示词批量打标签，始终可用） -->
                    <Button x:Name="ContextTagButton" Content="{i18n:Localize PromptBatchTag}" Click="OnBatchTagMenuItemClick"
                            HorizontalContentAlignment="Left" Padding="16,9" FontWeight="DemiBold"
                            Background="Transparent" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
                            </Style>
                        </Button.Styles>
                    </Button>

                    <!-- 加入文件夹（多选时批量加入，弹窗多选文件夹） -->
                    <Button x:Name="ContextAddToFolderButton" Content="{i18n:Localize AddToFolder}" Click="OnAddToFolderMenuItemClick"
                            HorizontalContentAlignment="Left" Padding="16,9" FontWeight="DemiBold"
                            Background="Transparent" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
                            </Style>
                        </Button.Styles>
                    </Button>

                    <!-- 复制到剪贴板（配合菜单管理页"粘贴"加入目标文件夹） -->
                    <Button x:Name="ContextCopyClipboardButton" Content="{i18n:Localize FolderCopyAsset}" Click="OnCopyToClipboardMenuItemClick"
                            HorizontalContentAlignment="Left" Padding="16,9" FontWeight="DemiBold"
                            Background="Transparent" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
                            </Style>
                        </Button.Styles>
                    </Button>

                    <Rectangle Height="1" Fill="{DynamicResource SukiBorderBrush}" Margin="8,2" />

                    <Button x:Name="ContextDeleteButton" Content="{i18n:Localize PromptDelete}" Click="OnDeleteMenuItemClick" Foreground="{DynamicResource DangerBrush}"
                            HorizontalContentAlignment="Left" Padding="16,9" FontWeight="DemiBold"
                            Background="Transparent" BorderThickness="0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 标签管理抽屉（与图库/工作流共用 TagManagerDrawer 组件：新建/重命名/删除统一实现） -->
        <controls:TagManagerDrawer DataContext="{Binding TagDrawer}" />
    </Grid>
</UserControl>
