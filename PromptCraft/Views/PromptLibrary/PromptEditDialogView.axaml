<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PromptCraft.ViewModels.PromptLibrary"
             xmlns:i18n="clr-namespace:Ke.Bee.Localization.Extensions;assembly=Ke.Bee.Localization"
             d:DesignWidth="820" d:DesignHeight="620"
             x:DataType="vm:PromptEditModel"
             x:Class="PromptCraft.Views.PromptLibrary.PromptEditDialogView"
             mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto" Margin="8">
        <ScrollViewer>
            <Grid ColumnDefinitions="330,*" ColumnSpacing="14">
                <!-- 左列：封面 / 标题 / 标签 / 备注 -->
                <StackPanel Spacing="10">
                    <!-- 封面 -->
                    <Border Height="150" CornerRadius="8" ClipToBounds="True"
                            Background="{DynamicResource OverlayLightBrush}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1"
                            Cursor="Hand" PointerPressed="OnCoverClick">
                        <Grid>
                            <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"
                                   IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                                <TextBlock Text="🖼" FontSize="30" HorizontalAlignment="Center" />
                                <TextBlock Text="{i18n:Localize PromptClickToSetCover}" FontSize="12"
                                           Foreground="Gray" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 标题 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{i18n:Localize PromptTitle}" FontSize="12" Foreground="Gray" />
                        <TextBox Text="{Binding Title, Mode=TwoWay}" Classes="Borderless" MaxLength="200" />
                    </StackPanel>

                    <!-- 标签（多选 + 即时新建，对齐 PromptMaster allow-create） -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{i18n:Localize Tags}" FontSize="12" Foreground="Gray" />
                        <ScrollViewer MaxHeight="140">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PromptTagItem">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Command="{Binding $parent[ItemsControl].((vm:PromptEditModel)DataContext).ToggleTagCommand}"
                                                  CommandParameter="{Binding}"
                                                  Tag="{Binding}" Margin="0,0,10,6">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Border Width="8" Height="8" CornerRadius="2"
                                                        Background="{Binding Color}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding NewTagName, Mode=TwoWay}"
                                     PlaceholderText="{i18n:Localize PromptNewTagPlaceholder}"
                                     Classes="Borderless" MaxLength="40" />
                            <Button Grid.Column="1" Content="{i18n:Localize AddTag}" FontSize="12" Padding="10,0"
                                    Command="{Binding AddNewTagCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- 备注 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{i18n:Localize PromptNote}" FontSize="12" Foreground="Gray" />
                        <TextBox Text="{Binding Note, Mode=TwoWay}" Classes="Borderless"
                                 MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>
                </StackPanel>

                <!-- 右列：正向 / 负向提示词 / 种子 / 模型 -->
                <StackPanel Grid.Column="1" Spacing="10">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{i18n:Localize PromptPositive}" FontSize="12" Foreground="Gray"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{i18n:Localize PromptCopyPositive}" FontSize="11"
                                    Padding="10,0" Height="24" Command="{Binding CopyPositiveCommand}" />
                        </Grid>
                        <TextBox Text="{Binding Positive, Mode=TwoWay}" Classes="Borderless"
                                 Height="160" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{i18n:Localize PromptNegative}" FontSize="12" Foreground="Gray"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{i18n:Localize PromptCopyNegative}" FontSize="11"
                                    Padding="10,0" Height="24" Command="{Binding CopyNegativeCommand}" />
                        </Grid>
                        <TextBox Text="{Binding Negative, Mode=TwoWay}" Classes="Borderless"
                                 Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{i18n:Localize PromptSeed}" FontSize="12" Foreground="Gray" />
                            <TextBox Text="{Binding Seed, Mode=TwoWay}" Classes="Borderless" />
                        </StackPanel>
                        <!-- 模型：分组下拉单选（图片/视频两组，选项来自源库 PromptMaster 列表；每组内每个模型占一行） -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{i18n:Localize PromptModels}" FontSize="12" Foreground="Gray" />
                            <DropDownButton MinWidth="150" HorizontalAlignment="Stretch">
                                <Grid>
                                    <TextBlock Text="{Binding Models}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Models, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{i18n:Localize PromptSelectModelPlaceholder}" FontSize="12" Foreground="Gray"
                                               IsVisible="{Binding Models, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                </Grid>
                                <DropDownButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <Border Background="{DynamicResource SukiCardBackground}"
                                                BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1"
                                                CornerRadius="6" MinWidth="250" MaxHeight="320">
                                            <ScrollViewer>
                                                <ItemsControl ItemsSource="{Binding ModelGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PromptModelGroup">
                                                            <StackPanel Margin="0,2">
                                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="Gray"
                                                                           FontWeight="DemiBold" Margin="10,8,10,4" />
                                                                <ItemsControl ItemsSource="{Binding Options}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:PromptModelOption">
                                                                            <Button Content="{Binding Name}" FontSize="11" Padding="8,4" Margin="2,1" CornerRadius="4"
                                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                    Background="Transparent"
                                                                                    BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="1"
                                                                                    Command="{Binding $parent[DropDownButton].((vm:PromptEditModel)DataContext).SelectModelCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 底部：仅状态（保存/取消按钮已移除 → 保存并入宿主 foot 关闭按钮左侧，取消不再提供） -->
        <Grid Grid.Row="1" ColumnDefinitions="*" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="Gray"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
    </Grid>
</UserControl>
